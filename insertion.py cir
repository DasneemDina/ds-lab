      "source": [
        "class Node:\n",
        "    def __init__(self, data):\n",
        "        self.data = data\n",
        "        self.next = None\n",
        "\n",
        "class CircularLinkedList:\n",
        "    def __init__(self):\n",
        "        self.last = None\n",
        "\n",
        "    def addToEmpty(self, data):\n",
        "        if (self.last != None):\n",
        "            return self.last\n",
        "\n",
        "        temp = Node(data)\n",
        "        self.last = temp\n",
        "        self.last.next = self.last\n",
        "        return self.last\n",
        "\n",
        "    def addBegin(self, data):\n",
        "        if (self.last == None):\n",
        "            return self.addToEmpty(data)\n",
        "\n",
        "        temp = Node(data)\n",
        "        temp.next = self.last.next\n",
        "        self.last.next = temp\n",
        "\n",
        "        return self.last\n",
        "\n",
        "    def addEnd(self, data):\n",
        "        if (self.last == None):\n",
        "            return self.addToEmpty(data)\n",
        "\n",
        "        temp = Node(data)\n",
        "        temp.next = self.last.next\n",
        "        self.last.next = temp\n",
        "        self.last = temp\n",
        "\n",
        "        return self.last\n",
        "\n",
        "    def addAfter(self, data, item):\n",
        "        if self.last is None:\n",
        "            print(\"List is empty. Cannot add after an item.\")\n",
        "            return None\n",
        "\n",
        "        temp = Node(data)\n",
        "        p = self.last.next # Start from the first element\n",
        "\n",
        "        # Traverse the list to find the item\n",
        "        while True:\n",
        "            if p.data == item:\n",
        "                temp.next = p.next\n",
        "                p.next = temp\n",
        "                if p == self.last: # If item was the last node, new node becomes the new last\n",
        "                    self.last = temp\n",
        "                return self.last # Item found and new node added\n",
        "            p = p.next\n",
        "            if p == self.last.next: # If we've traversed the whole list and returned to start\n",
        "                print(item, \"not present in the list\")\n",
        "                return self.last # Item not found, return current last\n",
        "\n",
        "    def traverse(self):\n",
        "        if (self.last == None):\n",
        "            print(\"List is empty\")\n",
        "            return\n",
        "\n",
        "        temp = self.last.next\n",
        "        while True:\n",
        "            print(temp.data, end = \" \")\n",
        "            temp = temp.next\n",
        "            if temp == self.last.next:\n",
        "                break\n",
        "        print() # For newline after printing all elements\n",
        "\n",
        "if __name__ == '__main__':\n",
        "\n",
        "    llist = CircularLinkedList()\n",
        "\n",
        "    last = llist.addToEmpty(6)\n",
        "    last = llist.addBegin(4)\n",
        "    last = llist.addBegin(2)\n",
        "    last = llist.addEnd(8)\n",
        "    last = llist.addEnd(12)\n",
        "    last = llist.addAfter(10,8)\n",
        "\n",
        "    llist.traverse()\n"
