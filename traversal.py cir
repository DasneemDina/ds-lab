      "source": [
        "class Node:\n",
        "    def __init__(self, data):\n",
        "        self.data = data\n",
        "        self.next = None\n",
        "\n",
        "class CircularLinkedList:\n",
        "    def __init__(self):\n",
        "        self.head = None\n",
        "\n",
        "    def push(self, data):\n",
        "        ptr1 = Node(data)\n",
        "        ptr1.next = self.head\n",
        "\n",
        "        if self.head is not None:\n",
        "            temp = self.head\n",
        "            while temp.next != self.head:\n",
        "                temp = temp.next\n",
        "            temp.next = ptr1\n",
        "        else:\n",
        "            # If list was empty, new node points to itself\n",
        "            ptr1.next = ptr1\n",
        "\n",
        "        self.head = ptr1\n",
        "\n",
        "    def printList(self):\n",
        "        temp = self.head\n",
        "\n",
        "        if self.head is None:\n",
        "            print(\"List is empty\")\n",
        "            return\n",
        "\n",
        "        while True:\n",
        "            print(f\"{temp.data}\", end=\" \")\n",
        "            temp = temp.next\n",
        "            if temp == self.head:\n",
        "                break\n",
        "        print()\n",
        "\n",
        "\n",
        "cllist = CircularLinkedList()\n",
        "cllist.push(12)\n",
        "cllist.push(56)\n",
        "cllist.push(2)\n",
        "cllist.push(11)\n",
        "print(\"Contents of circular Linked List\")\n",
        "cllist.printList()\n"
